{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "AI Recruiter Copilot — Monitoring",
  "description": "Dashboard de monitoring pour l'application AI Recruiter Copilot",
  "tags": ["ai-recruiter", "fastapi", "prometheus", "python"],
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "title": "Requêtes par seconde",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{method}} {{endpoint}}",
          "refId": "A"
        }
      ],
      "description": "Volume de requêtes HTTP par seconde, segmenté par méthode et endpoint"
    },
    {
      "title": "Durée des requêtes (p95)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 {{method}} {{endpoint}}",
          "refId": "A"
        }
      ],
      "description": "Latence au 95e percentile — idéal pour détecter les lenteurs"
    },
    {
      "title": "Taux d'erreur (%)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(http_requests_total{status_code=~\"5..\"}[5m]) / rate(http_requests_total[5m]) * 100",
          "legendFormat": "Error rate",
          "refId": "A"
        }
      ],
      "description": "Pourcentage de réponses 5xx sur le total des requêtes"
    },
    {
      "title": "Requêtes en cours",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "http_requests_in_progress",
          "legendFormat": "{{method}} {{endpoint}}",
          "refId": "A"
        }
      ],
      "description": "Nombre de requêtes actuellement en cours de traitement"
    },
    {
      "title": "Analyses de CV",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(analyses_total[5m])",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "description": "Volume d'analyses de CV par seconde (succès vs échec)"
    },
    {
      "title": "Informations application",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "app_info",
          "refId": "A"
        }
      ],
      "description": "Version et nom de l'application"
    }
  ],
  "schemaVersion": 27,
  "version": 1
}
